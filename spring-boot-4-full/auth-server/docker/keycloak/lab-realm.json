{
  "realm": "lab",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "users": [
    {
      "username": "ssouser@dkds.com",
      "email": "ssouser@dkds.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "SSO",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "ssopassword",
          "temporary": false
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "http://localhost:9000/saml2/service-provider-metadata/keycloak",
      "name": "auth-server (SAML SP)",
      "description": "auth-server SAML SP (lab, Phase 7). registrationId=keycloak matches Spring Security's default SP URL pattern, so no entityId override is needed.",
      "protocol": "saml",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:9000/login/saml2/sso/keycloak"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.server.signature.keyinfo.ext": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "username",
        "saml_force_name_id_format": "true",
        "saml.force.post.binding": "true",
        "saml_assertion_consumer_url_post": "http://localhost:9000/login/saml2/sso/keycloak",
        "saml_idp_initiated_sso_url_name": "keycloak"
      }
    }
  ],

