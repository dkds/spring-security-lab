# Copy to .env.local and adjust for your environment.
# All VITE_ variables are inlined at build time — never put secrets here.

# Base URL of the Spring Authorization Server
VITE_AUTH_ISSUER=http://localhost:9000

# OAuth2 client_id registered on the auth-server
VITE_CLIENT_ID=portal-ui

# Where the auth-server should redirect after login (must match registered redirect URI)
VITE_REDIRECT_URI=http://localhost:5173/callback

# Base URL of the resource-server
VITE_RESOURCE_BASE_URL=http://localhost:9001
